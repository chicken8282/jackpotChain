# ── 챗봇 (GMS API) ──────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 실제 키를 넣으세요.
# .env 는 .gitignore 에 포함되어 있어 git에 올라가지 않습니다.
VITE_GMS_API_KEY=여기에_GMS_API_키_입력

# ── GMS 프록시 호스트 (선택) ─────────────────────────────
# 미설정 시 기본값: https://gms.ssafy.io/gmsapi
# VITE_GMS_HOST=https://gms.ssafy.io/gmsapi