# =============================================================================
# .env.example
# 이 파일을 복사해서 .env.local 을 만들고 값을 채워주세요.
# cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (docker-compose.local.yml → postgres 서비스)
# -----------------------------------------------------------------------------
POSTGRES_DB=jackpotchain
POSTGRES_USER=jackpot
POSTGRES_PASSWORD=your-postgres-password

# -----------------------------------------------------------------------------
# RabbitMQ (docker-compose.local.yml → rabbitmq 서비스)
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=your-rabbitmq-password

# -----------------------------------------------------------------------------
# Spring Boot Backend 환경변수
# -----------------------------------------------------------------------------
LOCAL_DB_URL=jdbc:postgresql://postgres:5432/jackpotchain
LOCAL_DB_USERNAME=jackpot
LOCAL_DB_PASSWORD=your-postgres-password

LOCAL_REDIS_HOST=redis
LOCAL_REDIS_PORT=6379

LOCAL_RABBITMQ_HOST=rabbitmq
LOCAL_RABBITMQ_PORT=5672
LOCAL_RABBITMQ_USERNAME=guest
LOCAL_RABBITMQ_PASSWORD=your-rabbitmq-password

# JWT 서명 키 (256비트 이상, 운영 환경에서는 반드시 강력한 랜덤 값 사용)
LOCAL_JWT_SECRET=local-dev-secret-key-must-be-at-least-256-bits-long-for-hmac-sha256

LOCAL_JACKPOTCHAIN_RPC_URL=http://jackpotchain-node:9776

# -----------------------------------------------------------------------------
# JackpotChain 블록체인 노드
# -----------------------------------------------------------------------------
NODE_DATA_DIR=/data
NODE_WALLET_FILE=/wallets/default.json
NODE_RPC_HOST=0.0.0.0
NODE_RPC_PORT=9776
NODE_P2P_PORT=9777
# 시드 노드 주소 (로컬에서는 비워두면 됨)
NODE_SEED=
NODE_MINE=true
# 채굴 보상을 받을 지갑 주소 (비워두면 자동 생성된 지갑 주소 사용)
NODE_MINING_ADDRESS=
NODE_SEED_NODE=true
NODE_DISABLE_DISCOVERY=true

# -----------------------------------------------------------------------------
# Frontend 빌드 인자
# -----------------------------------------------------------------------------
# GMS(Google Map Style) API 키
VITE_GMS_API_KEY=your-gms-api-key
